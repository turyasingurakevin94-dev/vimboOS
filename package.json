{
  "name": "omniware",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter @ow/console dev",
    "build": "pnpm -r --filter './packages/**' build && pnpm --filter @ow/console build",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "lint": "eslint .",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
